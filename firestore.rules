rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isValidCourseYear(year) {
      return year is string && year in ['1-kurs', '2-kurs', '3-kurs', '4-kurs', 'Magistratura'];
    }

    function isValidStudentProfile(data) {
      return data.keys().hasAll([
          'uid', 'fullName', 'university', 'faculty', 'groupName', 'courseYear', 'email', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'fullName', 'university', 'faculty', 'groupName', 'courseYear', 'email', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.university is string && data.university.size() >= 2 && data.university.size() <= 180
        && data.faculty is string && data.faculty.size() >= 2 && data.faculty.size() <= 160
        && data.groupName is string && data.groupName.size() >= 1 && data.groupName.size() <= 60
        && isValidCourseYear(data.courseYear)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.email == request.auth.token.email
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkFormat(format) {
      return format is string && format in ['maqola', 'taqdimot', 'referat'];
    }

    function isValidWorkLanguage(lang) {
      return lang is string && lang in ['uz', 'en', 'ru'];
    }

    function isValidWorkDepth(depth) {
      return depth is string && depth in ['short', 'standard', 'extended'];
    }

    function isValidAcademicWork(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'format', 'subject', 'topic', 'language', 'depth',
          'title', 'sections', 'slides', 'references',
          'studentName', 'university', 'faculty', 'groupName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'format', 'subject', 'topic', 'language', 'depth',
          'requirements', 'title', 'subtitle', 'abstract', 'keywords',
          'sections', 'slides', 'references',
          'studentName', 'university', 'faculty', 'groupName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidWorkFormat(data.format)
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 140
        && data.topic is string && data.topic.size() >= 3 && data.topic.size() <= 240
        && isValidWorkLanguage(data.language)
        && isValidWorkDepth(data.depth)
        && (!('requirements' in data) || (data.requirements is string && data.requirements.size() <= 800))
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 260
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 300))
        && (!('abstract' in data) || (data.abstract is string && data.abstract.size() <= 3000))
        && (!('keywords' in data) || (
          data.keywords is list && data.keywords.size() <= 10 &&
          (data.keywords.size() == 0 || (data.keywords[0] is string && data.keywords[0].size() <= 80))
        ))
        && data.sections is list && data.sections.size() <= 15
        && (data.sections.size() == 0 || (
          data.sections[0] is map &&
          data.sections[0].keys().hasAll(['heading', 'paragraphs']) &&
          data.sections[0].keys().hasOnly(['heading', 'paragraphs']) &&
          data.sections[0].heading is string && data.sections[0].heading.size() <= 240 &&
          data.sections[0].paragraphs is list && data.sections[0].paragraphs.size() <= 20 &&
          (data.sections[0].paragraphs.size() == 0 || data.sections[0].paragraphs[0] is string)
        ))
        && data.slides is list && data.slides.size() <= 20
        && (data.slides.size() == 0 || (
          data.slides[0] is map &&
          data.slides[0].keys().hasAll(['title', 'bullets', 'notes']) &&
          data.slides[0].keys().hasOnly(['title', 'bullets', 'notes', 'subtitle']) &&
          data.slides[0].title is string && data.slides[0].title.size() <= 240 &&
          data.slides[0].bullets is list && data.slides[0].bullets.size() <= 12 &&
          (data.slides[0].bullets.size() == 0 || data.slides[0].bullets[0] is string) &&
          data.slides[0].notes is string && data.slides[0].notes.size() <= 1200
        ))
        && data.references is list && data.references.size() <= 20
        && (data.references.size() == 0 || (data.references[0] is string && data.references[0].size() <= 400))
        && data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 120
        && data.university is string && data.university.size() >= 2 && data.university.size() <= 180
        && data.faculty is string && data.faculty.size() >= 2 && data.faculty.size() <= 160
        && data.groupName is string && data.groupName.size() >= 1 && data.groupName.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /students/{studentId} {
      allow get: if isValidId(studentId) && isOwner(studentId);
      allow list: if false;
      allow create: if isValidId(studentId)
        && isOwner(studentId)
        && isValidStudentProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(studentId)
        && isOwner(studentId)
        && isValidStudentProfile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'university', 'faculty', 'groupName', 'courseYear', 'updatedAt'
        ])
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /works/{workId} {
      allow get: if isValidId(workId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(workId)
        && isVerifiedUser()
        && isValidAcademicWork(incoming())
        && incoming().id == workId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/students/$(request.auth.uid));
      allow update: if isValidId(workId)
        && isVerifiedUser()
        && existing().ownerId == request.auth.uid
        && isValidAcademicWork(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subtitle', 'abstract', 'keywords', 'sections', 'slides', 'references', 'updatedAt'
        ])
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().format == existing().format
        && incoming().subject == existing().subject
        && incoming().topic == existing().topic
        && incoming().language == existing().language
        && incoming().depth == existing().depth
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(workId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
    }
  }
}
